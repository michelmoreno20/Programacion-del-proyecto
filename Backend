app.post('/ventas', (req, res) => {
  const { id_cliente, id_usuario, items } = req.body;
  
  const total = items.reduce((sum, item) => sum + (item.precio * item.cantidad), 0);
  
  db.query(
    'INSERT INTO Venta (fecha, total, id_usuario, id_cliente) VALUES (NOW(), ?, ?, ?)',
    [total, id_usuario, id_cliente],
    (err, result) => {
      if (err) return res.status(500).json({ error: err });
      
      const id_venta = result.insertId;
      const detalles = items.map(item => [item.cantidad, item.precio * item.cantidad, id_venta, item.id_producto]);
      
      db.query(
        'INSERT INTO Detalle_Venta (cantidad, subtotal, id_venta, id_producto) VALUES ?',
        [detalles],
        (err2) => {
          if (err2) return res.status(500).json({ error: err2 });
          
          items.forEach(item => {
            db.query('UPDATE Producto SET cantidad_stock = cantidad_stock - ? WHERE id_producto = ?',
              [item.cantidad, item.id_producto]);
          });
          
          res.json({ mensaje: 'Venta registrada', id_venta });
        }
      );
    }
  );
});

app.listen(process.env.PORT, () => {
  console.log('API corriendo en http://localhost:3000');
});
